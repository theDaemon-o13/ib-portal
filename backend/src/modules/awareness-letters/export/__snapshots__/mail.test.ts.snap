exports[`содержимое редактора → почтовый HTML > снимок вымышленного письма 1`] = `"<p style="margin:0 0 14px 0;font-family:Arial, 'Segoe UI', Helvetica, sans-serif;font-size:15px;line-height:23px;color:#0F172A;"><strong>Уважаемые коллеги!</strong></p><p style="margin:0 0 14px 0;font-family:Arial, 'Segoe UI', Helvetica, sans-serif;font-size:15px;line-height:23px;color:#0F172A;">Мошенники рассылают письма о выигрыше. Не переходите по ссылкам.</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:4px 0 18px 0;"><tr><td width="4" style="width:4px;background:#2563EB;font-size:0;line-height:0;">&nbsp;</td><td style="background:#EFF6FF;padding:14px 18px;"><p style="margin:0 0 4px 0;font-family:Arial, 'Segoe UI', Helvetica, sans-serif;font-size:15px;line-height:23px;color:#0F172A;"><strong>Просьба:</strong></p><p style="margin:0;font-family:Arial, 'Segoe UI', Helvetica, sans-serif;font-size:15px;line-height:23px;color:#0F172A;">Пересылайте такие письма на <a href="mailto:security@example.org" style="color:#1D4ED8;text-decoration:underline;white-space:nowrap;">security@example.org</a>.</p></td></tr></table><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:4px 0 18px 0;"><tr><td width="4" style="width:4px;background:#DC2626;font-size:0;line-height:0;">&nbsp;</td><td style="background:#FEF2F2;padding:14px 18px;"><p style="margin:0 0 4px 0;font-family:Arial, 'Segoe UI', Helvetica, sans-serif;font-size:15px;line-height:23px;color:#0F172A;"><strong>Предупреждение:</strong></p><p style="margin:0;font-family:Arial, 'Segoe UI', Helvetica, sans-serif;font-size:15px;line-height:23px;color:#0F172A;">Никому не сообщайте коды из SMS.</p></td></tr></table><p style="margin:0 0 14px 0;font-family:Arial, 'Segoe UI', Helvetica, sans-serif;font-size:15px;line-height:23px;color:#0F172A;">Последний абзац.</p>"`;
