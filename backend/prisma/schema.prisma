// Схема меняется только миграциями (CLAUDE.md, раздел 3.3):
//   npx prisma migrate dev --create-only --name <что_меняем>
// Применённые файлы в migrations/ не правятся.

// Prisma 7 (ADR-0014): клиент генерируется в src/generated/prisma (в git не попадает), работает через
// драйвер-адаптер pg (lib/db.ts). Адрес БД — в prisma.config.ts.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  login              String    @unique
  fullName           String    @map("full_name")
  position           String    @default("")
  department         String    @default("")
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  /// От этой даты считается срок действия пароля (90 дней).
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  isActive           Boolean   @default(true) @map("is_active")
  /// Руководитель (релиз 1.2.0, ADR-0020): «старшие» — вся цепочка выше. Только пользователи с ib.work; цикл запрещён триггером.
  managerId          String?   @map("manager_id") @db.Uuid
  /// «Является начальником ИБ» (релиз 1.4.0): выполняет этап «Начальник ИБ» в маршруте документов. Не больше одного
  /// пользователя — частичный уникальный индекс users_ib_head_uq (в SQL миграции); только активный, с ib.work, не супер-администратор.
  isIbHead           Boolean   @default(false) @map("is_ib_head")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordHistory      PasswordHistory[]
  manager              User?                @relation("UserManager", fields: [managerId], references: [id], onDelete: Restrict)
  subordinates         User[]               @relation("UserManager")
  mailRules            CatalogItem[]
  ownedRegisters       Register[]
  decisions            RegisterDecision[]
  registerImports      RegisterImport[]
  scanReports          ScanReport[]
  automations          RegisterAutomation[]
  processedEvents      AutomationEvent[]
  assignedTasks        Task[]               @relation("TaskAssignee")
  createdTasks         Task[]               @relation("TaskCreator")
  taskComments         TaskComment[]
  taskTransitions      TaskTransition[]     @relation("TransitionActor")
  reviewTasks          Task[]               @relation("TaskReviewer")
  reviewTransitions    TaskTransition[]     @relation("TransitionReviewer")
  notifications        Notification[]       @relation("NotificationRecipient")
  notificationsSent    Notification[]       @relation("NotificationActor")
  recipientOf          CatalogItemUser[]
  ownedDocuments       Document[]           @relation("DocumentOwner")
  createdDocuments     Document[]           @relation("DocumentCreator")
  documentVersions     DocumentVersion[]
  documentApprovals    DocumentApproval[]
  uploadedFiles        File[]               @relation("FileUploader")
  deletedDocuments     Document[]           @relation("DocumentDeleter")
  documentComments     DocumentComment[]
  addedDocumentFiles   DocumentFile[]       @relation("DocumentFileAdder")
  removedDocumentFiles DocumentFile[]       @relation("DocumentFileRemover")
  documentPartyLinks   DocumentParty[]      @relation("DocumentPartyUser")
  addedDocumentParties DocumentParty[]      @relation("DocumentPartyAdder")
  approvedDocParties   DocumentParty[]      @relation("DocumentPartyApprover")
  removedDocParties    DocumentParty[]      @relation("DocumentPartyRemover")
  documentDeadlineChanges DocumentDeadlineChange[]
  translatedDocs       DocumentTranslation[] @relation("DocumentTranslator")
  addedDocTranslations DocumentTranslation[] @relation("DocumentTranslationAdder")
  removedDocTranslations DocumentTranslation[] @relation("DocumentTranslationRemover")
  openedDocBlockers    DocumentBlocker[]    @relation("DocumentBlockerOpener")
  createdAssessments   Assessment[]         @relation("AssessmentCreator")
  finalizedAssessments Assessment[]         @relation("AssessmentFinalizer")
  assessmentAnswers    AssessmentAnswer[]
  assessmentLinks      AssessmentLink[]
  resolvedDocBlockers  DocumentBlocker[]    @relation("DocumentBlockerResolver")
  deletedFiles         File[]               @relation("FileDeleter")
  ownedEvidence        Evidence[]           @relation("EvidenceOwner")
  uploadedEvidence     Evidence[]           @relation("EvidenceUploader")
  reviewedEvidence     Evidence[]           @relation("EvidenceReviewer")
  evidenceFilesAdded   EvidenceFile[]       @relation("EvidenceFileAdder")
  evidenceFilesRemoved EvidenceFile[]       @relation("EvidenceFileRemover")
  recordFilesAdded     RegisterRecordFile[] @relation("RecordFileAdder")
  recordFilesRemoved   RegisterRecordFile[] @relation("RecordFileRemover")
  dashboardTiles       DashboardTile[]
  automationRuns       AutomationRun[]
  dashboardLayout      DashboardLayout?     @relation("LayoutOwner")
  dashboardLayoutEdits DashboardLayout[]    @relation("LayoutEditor")
  monitorSlides        MonitorSlide[]
  roles                UserRole[]           @relation("UserRoles")
  assignedRoles        UserRole[]           @relation("UserRolesAssignedBy")
  sessions             Session[]
  auditEntries         AuditLog[]

  @@index([managerId])
  @@map("users")
}

model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model Permission {
  code        String @id
  name        String
  description String @default("")
  sortOrder   Int    @default(0) @map("sort_order")

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String?  @unique
  name        String   @unique
  description String   @default("")
  isSystem    Boolean  @default(false) @map("is_system")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions     RolePermission[]
  users           UserRole[]
  dashboardLayout DashboardLayout?

  @@map("roles")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user     User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner User? @relation("UserRolesAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// id — sha256 от токена из cookie; сам токен в БД не хранится.
model Session {
  id         String    @id
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// Только пополняется (CLAUDE.md, раздел 3.5). UPDATE и DELETE запрещены правами и триггером.
model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now()) @db.Timestamptz(3)
  userId   String?  @map("user_id") @db.Uuid
  action   String
  entity   String?
  entityId String?  @map("entity_id")
  diff     Json?
  ip       String?

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([at])
  @@index([entity, entityId])
  /// Раздел «Журнал»: фильтр по пользователю (релиз 1.2.0).
  @@index([userId, at])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Настройки (этап 2). Частичные уникальные индексы и CHECK — в SQL миграции.
// ---------------------------------------------------------------------------

/// Набор справочников фиксирован, создаётся seed.
model Catalog {
  code        String  @id
  name        String
  description String  @default("")
  /// values | statuses | mail_rules
  kind        String
  hasColor    Boolean @default(false) @map("has_color")
  sortOrder   Int     @default(0) @map("sort_order")

  items          CatalogItem[]
  registerFields RegisterField[]

  @@map("catalogs")
}

model CatalogItem {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogCode    String    @map("catalog_code")
  value          String
  /// Ключ тона из tokens.css: accent, info, low, high, med, crit, muted
  color          String?
  /// Есть только у системных значений, на них опирается логика.
  systemKey      String?   @map("system_key")
  isSystem       Boolean   @default(false) @map("is_system")
  /// Только для правил разбора почты.
  keywords       String[]  @default([])
  /// Ответственный правила почты; владелец системы (справочник «Системы»).
  ownerUserId    String?   @map("owner_user_id") @db.Uuid
  /// Только для меток «Получатели уведомлений»: адреса вне портала — для справки, письма портал не отправляет.
  emails         String[]  @default([])
  sortOrder      Int       @default(0) @map("sort_order")
  /// Только «Статусы задач» (релиз 1.2.0, ADR-0022): при переходе в эту колонку вперёд (из колонки левее) обязателен комментарий.
  commentForward Boolean   @default(false) @map("comment_forward")
  /// Только «Статусы задач»: при возврате в эту колонку (из колонки правее) обязателен комментарий.
  commentReturn  Boolean   @default(false) @map("comment_return")
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  catalog         Catalog           @relation(fields: [catalogCode], references: [code], onDelete: Restrict)
  owner           User?             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  members         CatalogItemUser[]
  tasksByStatus   Task[]            @relation("TaskStatus")
  tasksByPriority Task[]            @relation("TaskPriority")
  tasksByCategory Task[]            @relation("TaskCategory")
  transitionsFrom TaskTransition[]  @relation("TransitionFrom")
  transitionsTo   TaskTransition[]  @relation("TransitionTo")
  mailSources     TaskMailSource[]
  documents       Document[]
  evidence        Evidence[]

  @@unique([catalogCode, systemKey])
  @@index([catalogCode, sortOrder])
  @@map("catalog_items")
}

/// Производственный календарь РТ: отклонения от обычной недели.
model WorkCalendarDay {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day       DateTime  @db.Date
  /// holiday — нерабочий день; workday — рабочий день (перенос на выходной)
  kind      String
  title     String
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([day])
  @@map("work_calendar_days")
}

/// Настройки портала: ключ → значение (например, выходные дни недели).
model AppSetting {
  key       String   @id
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

/// Отметки однократного seed: стартовые значения создаются только при первой установке.
model SeedMarker {
  key       String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(3)

  @@map("seed_markers")
}

model FormTemplate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  /// Документ-основание текстом; ссылка на documents появится на этапе 6.
  basis       String    @default("")
  validMonths Int       @map("valid_months")
  version     Int       @default(1)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  fields   FormTemplateField[]
  evidence Evidence[]

  @@map("form_templates")
}

model FormTemplateField {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String    @map("template_id") @db.Uuid
  label      String
  /// min | max | yes | text
  checkKind  String    @map("check_kind")
  threshold  Decimal?  @db.Decimal(14, 2)
  sortOrder  Int       @default(0) @map("sort_order")
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  template FormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([templateId, sortOrder])
  @@map("form_template_fields")
}

// ---------------------------------------------------------------------------
// Конструктор реестров (этап 3). CHECK и частичные уникальные индексы — в SQL миграции.
// Значения записи хранятся по id поля (values: { fieldId: значение }), списки — по id варианта.
// ---------------------------------------------------------------------------

model Register {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  description          String    @default("")
  ownerUserId          String?   @map("owner_user_id") @db.Uuid
  /// Системный реестр: vulns — реестр уязвимостей (этап 4). Не архивируется.
  systemKey            String?   @unique @map("system_key")
  /// Следующий номер записи (колонка ID в Excel).
  nextNumber           Int       @default(1) @map("next_number")
  /// Сравнение с реестром (релиз 1.1.0): поля ключа по порядку (пусто — по ID) и поля, по которым выбирается область.
  compareKeyFieldIds   String[]  @default([]) @map("compare_key_field_ids") @db.Uuid
  compareScopeFieldIds String[]  @default([]) @map("compare_scope_field_ids") @db.Uuid
  version              Int       @default(1)
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner          User?                @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  fields         RegisterField[]      @relation("RegisterFields")
  /// Поля «Связь с записью» других реестров, которые ссылаются на этот (этап 8б).
  linkedBy       RegisterField[]      @relation("FieldLinkRegister")
  records        RegisterRecord[]
  imports        RegisterImport[]
  scanReports    ScanReport[]
  automations    RegisterAutomation[]
  events         AutomationEvent[]
  tiles          DashboardTile[]
  automationRuns AutomationRun[]

  @@map("registers")
}

model RegisterField {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registerId     String    @map("register_id") @db.Uuid
  label          String
  /// text | select | number | date | user | calc | decision | catalog
  type           String
  /// Только у поля «Значение справочника»: из какого справочника значения (CHECK в SQL миграции).
  catalogCode    String?   @map("catalog_code")
  sortOrder      Int       @default(0) @map("sort_order")
  /// dimension | metric | date | deadline — совместимость с типом проверяет CHECK
  analyticsRole  String?   @map("analytics_role")
  /// Заголовок записи (одно текстовое поле в реестре).
  isTitle        Boolean   @default(false) @map("is_title")
  /// Поле статуса (один список в реестре); закрытые варианты — is_closed.
  isStatus       Boolean   @default(false) @map("is_status")
  /// Ключ импорта Excel без колонки ID (одно текстовое поле в реестре; частичный уникальный индекс в SQL).
  isImportKey    Boolean   @default(false) @map("is_import_key")
  /// Только у вычисляемого поля. kind: due_date (по умолчанию) | vuln_score — см. lib/register-values.ts
  calcRule       Json?     @map("calc_rule")
  /// Только у поля «Связь с записью»: реестр, на записи которого ссылается поле (этап 8б, ADR-0013).
  linkRegisterId String?   @map("link_register_id") @db.Uuid
  /// Настройки поля (этап 8б): lock — фиксация при статусах; date — «не позже 31.12 года поля N», значение по умолчанию.
  /// Формат — lib/field-settings.ts.
  settings       Json?
  /// Системное поле: переименовать можно, удалить, архивировать и сменить тип — нет.
  /// Уникален в пределах реестра (частичный индекс в SQL миграции).
  systemKey      String?   @map("system_key")
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  register     Register              @relation("RegisterFields", fields: [registerId], references: [id], onDelete: Restrict)
  linkRegister Register?             @relation("FieldLinkRegister", fields: [linkRegisterId], references: [id], onDelete: Restrict)
  catalog      Catalog?              @relation(fields: [catalogCode], references: [code], onDelete: Restrict)
  options      RegisterFieldOption[]
  files        RegisterRecordFile[]
  decisions    RegisterDecision[]
  tiles        DashboardTile[]

  @@index([registerId, sortOrder])
  @@map("register_fields")
}

model RegisterFieldOption {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId    String    @map("field_id") @db.Uuid
  label      String
  sortOrder  Int       @default(0) @map("sort_order")
  /// Закрытый статус (для поля-статуса).
  isClosed   Boolean   @default(false) @map("is_closed")
  /// Системное значение (например, «Есть, эксплуатируется» для множителя Кэ): не удаляется и не архивируется.
  systemKey  String?   @map("system_key")
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  field     RegisterField      @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  decisions RegisterDecision[]

  @@index([fieldId, sortOrder])
  @@map("register_field_options")
}

model RegisterRecord {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registerId     String                   @map("register_id") @db.Uuid
  /// Номер записи в реестре — колонка ID при экспорте и импорте.
  number         Int
  /// { fieldId: значение }. Вычисляемые поля и решения здесь не хранятся.
  values         Json                     @default("{}")
  /// Отображаемые значения для поиска; пересчитываются при записи.
  searchText     String                   @default("") @map("search_text")
  /// Поля, исправленные вручную: автоматический пересчёт их не перетирает (критичность уязвимости).
  manualFieldIds String[]                 @default([]) @map("manual_field_ids") @db.Uuid
  /// Нормализованное значение поля-ключа импорта; заполняет триггер, уникально среди неудалённых записей реестра.
  importKey      String?                  @map("import_key")
  /// Полнотекстовый индекс search_text (русская морфология) — вычисляемая колонка, пишет только БД.
  searchTsv      Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, search_text)")) @map("search_tsv")
  version        Int                      @default(1)
  archivedAt     DateTime?                @map("archived_at") @db.Timestamptz(3)
  deletedAt      DateTime?                @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  register  Register             @relation(fields: [registerId], references: [id], onDelete: Restrict)
  decisions RegisterDecision[]
  events    AutomationEvent[]
  tasks     Task[]
  evidence  Evidence[]
  files     RegisterRecordFile[]

  @@unique([registerId, number])
  @@index([searchTsv], type: Gin)
  /// Обратные связи поля «Связь с записью»: "values" @> {"<поле>": ["<id записи>"]}.
  @@index([values(ops: JsonbPathOps)], type: Gin)
  @@map("register_records")
}

/// Решения другого отдела. Только пополняется; вносится с документом-основанием (файл — этап 7).
model RegisterDecision {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordId       String    @map("record_id") @db.Uuid
  fieldId        String    @map("field_id") @db.Uuid
  optionId       String    @map("option_id") @db.Uuid
  documentTitle  String    @map("document_title")
  documentNumber String    @map("document_number")
  documentDate   DateTime  @map("document_date") @db.Date
  /// Файл документа-основания (этап 7): без него решение не вносится.
  fileId         String    @map("file_id") @db.Uuid
  /// «Пересмотр до» по документу другого отдела; необязательно.
  reviewDue      DateTime? @map("review_due") @db.Date
  decidedBy      String    @map("decided_by") @db.Uuid
  decidedAt      DateTime  @default(now()) @map("decided_at") @db.Timestamptz(3)

  record   RegisterRecord      @relation(fields: [recordId], references: [id], onDelete: Restrict)
  field    RegisterField       @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  option   RegisterFieldOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
  author   User                @relation(fields: [decidedBy], references: [id], onDelete: Restrict)
  file     File                @relation(fields: [fileId], references: [id], onDelete: Restrict)
  evidence Evidence?

  @@index([recordId, fieldId, decidedAt(sort: Desc)])
  @@map("register_decisions")
}

/// Импорт Excel: предпросмотр хранится до применения (30 минут). Файл не хранится — только имя и sha256.
model RegisterImport {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registerId String    @map("register_id") @db.Uuid
  /// records — обычный импорт Excel; scan — отчёт сканера (CHECK в SQL миграции)
  kind       String    @default("records")
  /// preview | applied | cancelled | expired
  status     String    @default("preview")
  fileName   String    @map("file_name")
  fileSha256 String    @map("file_sha256")
  summary    Json
  /// Нормализованные изменения и версии записей на момент предпросмотра.
  payload    Json
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  appliedAt  DateTime? @map("applied_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Файл, по которому сравнивали с реестром (релиз 1.1.0): хранится как доказательство, держит файл от уборки.
  fileId     String?   @map("file_id") @db.Uuid

  register   Register    @relation(fields: [registerId], references: [id], onDelete: Restrict)
  file       File?       @relation(fields: [fileId], references: [id], onDelete: Restrict)
  author     User        @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  scanReport ScanReport?

  @@index([registerId, createdAt])
  @@map("register_imports")
}

// ---------------------------------------------------------------------------
// Реестр уязвимостей (этап 4): отчёты сканера и их хосты.
// ---------------------------------------------------------------------------

/// Применённый отчёт сканера. Создаётся одной транзакцией с записями реестра.
model ScanReport {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registerId   String    @map("register_id") @db.Uuid
  importId     String    @unique @map("import_id") @db.Uuid
  fileName     String    @map("file_name")
  fileSha256   String    @map("file_sha256")
  /// Дата отчёта: из имени файла (ГГГГ-ММ-ДД) или введена в предпросмотре.
  reportDate   DateTime  @map("report_date") @db.Date
  /// Дата передачи отчёта в ДИКТ — от неё считается срок п. 7.2.
  notifiedDate DateTime  @map("notified_date") @db.Date
  /// Ячейка A1 листа «Хосты».
  department   String    @default("")
  /// Значение поля «Отчёт сканирования»: «Отдел · 15.10.2026».
  label        String
  rowsTotal    Int       @map("rows_total")
  createdCount Int       @map("created_count")
  mergedCount  Int       @map("merged_count")
  hostsCount   Int       @map("hosts_count")
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)

  register Register       @relation(fields: [registerId], references: [id], onDelete: Restrict)
  import   RegisterImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  author   User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  hosts    ScanHost[]

  @@index([registerId, reportDate])
  @@map("scan_reports")
}

model ScanHost {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId  String @map("report_id") @db.Uuid
  sortOrder Int    @map("sort_order")
  name      String
  ip        String @default("")
  os        String @default("")

  report ScanReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId, sortOrder])
  @@map("scan_hosts")
}

// ---------------------------------------------------------------------------
// Автоматизации «условие → действие» (этап 4). До появления задач (этап 5) действие —
// событие в automation_events; на этапе 5 события превращаются в задачи.
// ---------------------------------------------------------------------------

model RegisterAutomation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registerId String    @map("register_id") @db.Uuid
  /// Системное правило (п. 7.4): не удаляется, только выключается.
  systemKey  String?   @map("system_key")
  /// { kind: before | overdue | equals, ... } — см. modules/automations/conditions.ts
  condition  Json
  /// { eventType: remind | notify | escalate, recipients: [...] }
  action     Json
  enabled    Boolean   @default(true)
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  register Register          @relation(fields: [registerId], references: [id], onDelete: Restrict)
  author   User?             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  events   AutomationEvent[]
  tasks    Task[]

  @@index([registerId])
  @@map("register_automations")
}

/// Событие автоматизации. Уникально по (правило, запись, trigger_key): повторный прогон дублей не создаёт.
model AutomationEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Событие реестра: реестр, запись и правило. Событие документа (пересмотр, этап 6) — только documentId.
  registerId   String?   @map("register_id") @db.Uuid
  recordId     String?   @map("record_id") @db.Uuid
  automationId String?   @map("automation_id") @db.Uuid
  documentId   String?   @map("document_id") @db.Uuid
  /// Событие доказательства (этап 7): срок действия истекает.
  evidenceId   String?   @map("evidence_id") @db.Uuid
  /// remind | notify | escalate
  eventType    String    @map("event_type")
  /// Снимок получателей на момент события: [{ kind: user, userId, name } | { kind: label, label }]
  recipients   Json
  /// Что сработало: дата срока (before, overdue) или id значения (equals).
  triggerKey   String    @map("trigger_key")
  /// День срабатывания (по часовому поясу портала).
  fireAt       DateTime  @map("fire_at") @db.Date
  /// new | processed
  status       String    @default("new")
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(3)
  processedBy  String?   @map("processed_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  register   Register?             @relation(fields: [registerId], references: [id], onDelete: Restrict)
  record     RegisterRecord?       @relation(fields: [recordId], references: [id], onDelete: Restrict)
  automation RegisterAutomation?   @relation(fields: [automationId], references: [id], onDelete: Restrict)
  document   Document?             @relation(fields: [documentId], references: [id], onDelete: Restrict)
  evidence   Evidence?             @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  processor  User?                 @relation(fields: [processedBy], references: [id], onDelete: Restrict)
  tasks      AutomationEventTask[]
  comments   TaskComment[]

  @@unique([automationId, recordId, triggerKey])
  @@index([registerId, status, createdAt])
  @@index([recordId])
  @@map("automation_events")
}

// ---------------------------------------------------------------------------
// Задачи (этап 5)
// ---------------------------------------------------------------------------

/// Метка «Получатели уведомлений» → пользователи портала (только с ib.work, проверяет сервис).
model CatalogItemUser {
  itemId String @map("item_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  item CatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([itemId, userId])
  @@index([userId])
  @@map("catalog_item_users")
}

model Task {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Сквозной номер «Задача #123».
  number         Int       @unique @default(autoincrement())
  title          String
  description    String    @default("")
  statusId       String    @map("status_id") @db.Uuid
  priorityId     String    @map("priority_id") @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  /// NULL — «не назначен» (метка без пользователей).
  assigneeId     String?   @map("assignee_id") @db.Uuid
  dueDate        DateTime? @map("due_date") @db.Date
  /// manual | mail | automation
  source         String
  /// Задача автоматизации: запись реестра и правило.
  recordId       String?   @map("record_id") @db.Uuid
  automationId   String?   @map("automation_id") @db.Uuid
  /// Метка получателя, по которой назначена задача («Руководитель ДИКТ», «Владелец системы»…).
  recipientLabel String?   @map("recipient_label")
  /// Задача по документу (этап 6): пересмотр или возврат на доработку.
  documentId     String?   @map("document_id") @db.Uuid
  /// review | returned
  documentReason String?   @map("document_reason")
  /// Задача по доказательству (этап 7): отклонено или истекает срок действия.
  evidenceId     String?   @map("evidence_id") @db.Uuid
  /// rejected | expiring
  evidenceReason String?   @map("evidence_reason")
  /// Когда задача перешла в «Готово»; NULL — открыта.
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  /// NULL — создано автоматизацией.
  createdBy      String?   @map("created_by") @db.Uuid
  /// Проверяющий (релиз 1.4.0, ADR-0028): фиксируется при отправке «На проверке» — ближний активный руководитель
  /// исполнителя. NULL — задача не на проверке или отправлена до 1.4.0 без цепочки (старые правила, tasks.review).
  reviewerId     String?   @map("reviewer_id") @db.Uuid
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  status        CatalogItem           @relation("TaskStatus", fields: [statusId], references: [id], onDelete: Restrict)
  priority      CatalogItem           @relation("TaskPriority", fields: [priorityId], references: [id], onDelete: Restrict)
  category      CatalogItem           @relation("TaskCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  assignee      User?                 @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creator       User?                 @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  reviewer      User?                 @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  record        RegisterRecord?       @relation(fields: [recordId], references: [id], onDelete: Restrict)
  automation    RegisterAutomation?   @relation(fields: [automationId], references: [id], onDelete: Restrict)
  document      Document?             @relation(fields: [documentId], references: [id], onDelete: Restrict)
  evidence      Evidence?             @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  mail          TaskMailSource?
  comments      TaskComment[]
  events        AutomationEventTask[]
  transitions   TaskTransition[]
  notifications Notification[]

  @@index([statusId])
  @@index([assigneeId, dueDate])
  @@index([recordId])
  @@index([documentId])
  @@index([evidenceId])
  /// Задачи автоматизации: удаление и архив правила, фильтр «создано автоматизацией» (релиз 1.1.0).
  @@index([automationId])
  /// «Ждут моей проверки» (индикаторы, отключение проверяющего).
  @@index([reviewerId])
  @@map("tasks")
}

/// Исходное письмо задачи «Почта → задача».
model TaskMailSource {
  taskId     String   @id @map("task_id") @db.Uuid
  fromText   String   @default("") @map("from_text")
  subject    String   @default("")
  sentText   String   @default("") @map("sent_text")
  body       String
  raw        String
  /// Сработавшее правило разбора почты и совпавшие слова.
  mailRuleId String?  @map("mail_rule_id") @db.Uuid
  ruleHits   String[] @default([]) @map("rule_hits")
  /// Почему такой срок: «в письме: «до 27.10»», «по умолчанию 3 рабочих дня»…
  dueReason  String   @map("due_reason")

  task     Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  mailRule CatalogItem? @relation(fields: [mailRuleId], references: [id], onDelete: Restrict)

  @@map("task_mail_sources")
}

model TaskComment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  /// NULL — комментарий автоматизации.
  authorId     String?   @map("author_id") @db.Uuid
  /// Событие автоматизации, добавившее комментарий в открытую задачу.
  eventId      String?   @map("event_id") @db.Uuid
  /// Комментарий перехода между колонками (релиз 1.2.0): тот же текст, что в task_transitions.
  transitionId String?   @map("transition_id") @db.Uuid
  body         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  task       Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author     User?            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  event      AutomationEvent? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  transition TaskTransition?  @relation(fields: [transitionId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

/// Переходы задачи между колонками (релиз 1.2.0, ADR-0022). Только пополняется: права и триггер, как у audit_log.
model TaskTransition {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  /// NULL — задача создана сразу в этой колонке.
  fromStatusId String?  @map("from_status_id") @db.Uuid
  toStatusId   String   @map("to_status_id") @db.Uuid
  /// NULL — система (автоматизации, документы, доказательства, обновление).
  actorId      String?  @map("actor_id") @db.Uuid
  /// process — кнопки процесса; override — свободная смена; assign — назначение/снятие исполнителя; system; migration
  kind         String
  comment      String   @default("")
  /// Проверяющий, зафиксированный этим переходом (релиз 1.4.0): отправка на проверку, замена проверяющего.
  reviewerId   String?  @map("reviewer_id") @db.Uuid
  at           DateTime @default(now()) @db.Timestamptz(3)

  task       Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  fromStatus CatalogItem?  @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Restrict)
  toStatus   CatalogItem   @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Restrict)
  actor      User?         @relation("TransitionActor", fields: [actorId], references: [id], onDelete: Restrict)
  reviewer   User?         @relation("TransitionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  comments   TaskComment[]

  @@index([taskId, at])
  @@map("task_transitions")
}

/// Что событие автоматизации сделало с задачей: создало или прокомментировало.
/// Журнал запусков автоматизаций (релиз 1.1.0, задача 2). Технический: строки удаляет «Очистить»
/// по праву registers.manage, с записью в журнале аудита. register_id NULL — общий прогон по всем реестрам.
/// Раскладка дашборда (релиз 1.1.0, задача 5): пользователя или по умолчанию для роли (ровно одно из двух —
/// CHECK в SQL). items — [{ key, hidden, size }]; неизвестные ключи пропускаются, новые элементы — в конец.
model DashboardLayout {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @unique @map("user_id") @db.Uuid
  roleId    String?  @unique @map("role_id") @db.Uuid
  items     Json
  version   Int      @default(1)
  /// NULL — раскладка роли из seed.
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User? @relation("LayoutOwner", fields: [userId], references: [id], onDelete: Restrict)
  role   Role? @relation(fields: [roleId], references: [id], onDelete: Restrict)
  editor User? @relation("LayoutEditor", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("dashboard_layouts")
}

/// Слайд экрана мониторинга (релиз 1.1.0, задача 6, ADR-0019). Одна настройка на все настенные мониторы;
/// правит settings.manage, киоск только читает. kind и диапазоны — CHECK в SQL; удаление мягкое.
model MonitorSlide {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// kpis | vulns | tasks | documents | risks | evidence | dlp
  kind      String
  title     String
  seconds   Int       @default(12)
  filter    Json      @default("{}")
  enabled   Boolean   @default(true)
  /// Нет данных — слайд не показывается (иначе — текст «Нет …»).
  skipEmpty Boolean   @default(false) @map("skip_empty")
  sortOrder Int       @map("sort_order")
  version   Int       @default(1)
  /// NULL — слайд seed.
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  author User? @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([sortOrder])
  @@map("monitor_slides")
}

model AutomationRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registerId     String?   @map("register_id") @db.Uuid
  /// schedule | manual | import
  trigger        String
  /// Кто запустил («Проверить сейчас», импорт); NULL — по расписанию.
  actorId        String?   @map("actor_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  rules          Int       @default(0)
  checked        Int       @default(0)
  eventsCreated  Int       @default(0) @map("events_created")
  tasksCreated   Int       @default(0) @map("tasks_created")
  tasksCommented Int       @default(0) @map("tasks_commented")
  error          String?

  register Register? @relation(fields: [registerId], references: [id], onDelete: Restrict)
  actor    User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([registerId, startedAt(sort: Desc)])
  @@map("automation_runs")
}

model AutomationEventTask {
  eventId String @map("event_id") @db.Uuid
  taskId  String @map("task_id") @db.Uuid
  /// created | commented
  action  String

  event AutomationEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  task  Task            @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([eventId, taskId])
  @@index([taskId])
  @@map("automation_event_tasks")
}

// ---------------------------------------------------------------------------
// Этап 6: внутренние документы ИБ, маршрут согласования, пересмотр (ADR-0010).
// ---------------------------------------------------------------------------

/// Документ: «шапка» с владельцем, типом и циклом пересмотра. Содержимое — в версиях.
/// Статус не хранится: считается из версий и даты пересмотра (modules/documents/status.ts).
model Document {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number            Int       @unique @default(autoincrement())
  typeId            String    @map("type_id") @db.Uuid
  /// Только активный пользователь с ib.work: ему ставятся задачи.
  ownerId           String    @map("owner_id") @db.Uuid
  reviewMonths      Int       @default(12) @map("review_months")
  /// Дата утверждения + цикл; NULL — ещё не утверждён.
  reviewDue         DateTime? @map("review_due") @db.Date
  /// Последняя утверждённая версия.
  approvedVersionId String?   @unique @map("approved_version_id") @db.Uuid
  /// Черновик или версия в маршруте; не больше одной.
  workingVersionId  String?   @unique @map("working_version_id") @db.Uuid
  version           Int       @default(1)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(3)
  /// Мягкое удаление (релиз 1.2.0, docs.delete): только документ без подписанной версии; удалённый — ещё и в архиве.
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy         String?   @map("deleted_by") @db.Uuid
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  type            CatalogItem        @relation(fields: [typeId], references: [id], onDelete: Restrict)
  owner           User               @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator         User               @relation("DocumentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  deleter         User?              @relation("DocumentDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)
  approvedVersion DocumentVersion?   @relation("DocumentApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: Restrict)
  workingVersion  DocumentVersion?   @relation("DocumentWorkingVersion", fields: [workingVersionId], references: [id], onDelete: Restrict)
  versions        DocumentVersion[]  @relation("DocumentVersions")
  approvals       DocumentApproval[]
  comments        DocumentComment[]
  files           DocumentFile[]
  parties         DocumentParty[]
  translations    DocumentTranslation[]
  deadlineChanges DocumentDeadlineChange[]
  blockers        DocumentBlocker[]
  events          AutomationEvent[]
  tasks           Task[]
  evidence        Evidence[]
  notifications   Notification[]

  @@index([ownerId])
  @@map("documents")
}

/// Версия документа. Утверждённая (approved_at задан) не меняется и не удаляется — права и триггер.
model DocumentVersion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId    String    @map("document_id") @db.Uuid
  /// 1, 2, 3… — ставит портал.
  no            Int
  /// «Редакция» для отображения, например «3.1»; необязательна.
  edition       String    @default("")
  title         String
  onlyofficeUrl String    @map("onlyoffice_url")
  changeNote    String    @default("") @map("change_note")
  /// Маршрут 1.2.0 (ADR-0024): 11 драфт … 16 подписание. Старый маршрут (до 1.2.0): 0 — автор, 1 — начальник ИБ,
  /// 2 — юридический отдел, 3 — правление; на нём остаются только версии, утверждённые до 1.2.0.
  stage         Int       @default(0) @db.SmallInt
  /// Круг маршрута: +1 при каждом возврате на доработку.
  round         Int       @default(1)
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(3)
  /// Дата подписания (этап 16): от неё считается дата пересмотра.
  signedOn      DateTime? @map("signed_on") @db.Date
  /// Пересмотр отменён: версия остаётся в истории, действующей остаётся подписанная.
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// Итоговый PDF (этап 7); на маршруте 1.2.0 — подписанный PDF (этап 16): прикладывает автор при отправке на согласование, все этапы согласуют этот файл.
  /// Утверждённая версия без PDF (утверждена до этапа 7) — «текст не зафиксирован».
  pdfFileId     String?   @map("pdf_file_id") @db.Uuid
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  pdf        File?              @relation(fields: [pdfFileId], references: [id], onDelete: Restrict)
  document   Document           @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Restrict)
  author     User               @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  approvedOf Document?          @relation("DocumentApprovedVersion")
  workingOf  Document?          @relation("DocumentWorkingVersion")
  approvals  DocumentApproval[]
  comments   DocumentComment[]
  files      DocumentFile[]
  parties    DocumentParty[]
  translations DocumentTranslation[]
  blockers   DocumentBlocker[]

  @@unique([documentId, no])
  @@map("document_versions")
}

/// История согласования. Только пополняется (права и триггер, как register_decisions).
model DocumentApproval {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  versionId  String   @map("version_id") @db.Uuid
  versionNo  Int      @map("version_no")
  round      Int
  stage      Int      @db.SmallInt
  /// Куда перешёл документ (маршрут 1.2.0); NULL — решение старого маршрута или без перехода.
  toStage    Int?     @map("to_stage") @db.SmallInt
  /// submitted | approved | returned | revision_started | skipped | moved | signed | migrated | cancelled
  decision   String
  /// Этап 13 согласовал сам автор — начальник ИБ, другого согласующего нет: без независимого согласования.
  selfApproved Boolean @default(false) @map("self_approved")
  comment    String   @default("")
  /// sha256 PDF версии на момент решения (этап 7): какой именно текст согласован.
  pdfSha256  String?  @map("pdf_sha256") @db.Char(64)
  /// Файл к возврату на доработку (1.4.0, по желанию): записка начальника ИБ. Колонкой в решении, а не видом
  /// document_files, — backend 1.3.0 после отката её не читает (вид файла в document_files ломал бы его карточку).
  fileId     String?  @map("file_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(3)

  document Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version  DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  file     File?           @relation(fields: [fileId], references: [id], onDelete: Restrict)
  actor    User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([documentId, at])
  @@index([versionId, round])
  @@map("document_approvals")
}

/// Комментарии сотрудников ИБ к документу (этап 12 «Проверка сотрудниками»). Не правятся и не удаляются.
model DocumentComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  versionId  String   @map("version_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version  DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@map("document_comments")
}

/// Файлы версии документа (релиз 1.2.0): draft — файлы драфта (снимаются на этапе 11), head_approved — версия,
/// одобренная начальником ИБ (13 → 14), final — финальная версия (14 → 15), response — ответ ответственного лица
/// (этап 14, party_id), translation — файл перевода (этап 15, translation_id). Зафиксированные файлы не снимаются.
model DocumentFile {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String    @map("document_id") @db.Uuid
  versionId  String    @map("version_id") @db.Uuid
  /// Круг маршрута версии, в котором приложен файл.
  round      Int
  kind       String
  fileId     String    @map("file_id") @db.Uuid
  addedBy    String    @map("added_by") @db.Uuid
  addedAt    DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(3)
  removedBy  String?   @map("removed_by") @db.Uuid
  /// Ответ ответственного лица (kind = response).
  partyId    String?   @map("party_id") @db.Uuid
  /// Файл перевода (kind = translation).
  translationId String? @map("translation_id") @db.Uuid

  document Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version  DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  party    DocumentParty?  @relation(fields: [partyId], references: [id], onDelete: Restrict)
  translation DocumentTranslation? @relation(fields: [translationId], references: [id], onDelete: Restrict)
  file     File            @relation(fields: [fileId], references: [id], onDelete: Restrict)
  adder    User            @relation("DocumentFileAdder", fields: [addedBy], references: [id], onDelete: Restrict)
  remover  User?           @relation("DocumentFileRemover", fields: [removedBy], references: [id], onDelete: Restrict)

  @@index([versionId, round])
  @@index([fileId])
  @@map("document_files")
}

/// Ответственные лица этапа 14 (релиз 1.2.0): внешние люди, которым документ отправлен по почте; e-mail — для справки,
/// портал писем не отправляет. По желанию — ссылка на пользователя портала. Согласование отмечает автор или начальник ИБ.
model DocumentParty {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  versionId      String    @map("version_id") @db.Uuid
  fullName       String    @map("full_name")
  department     String    @default("")
  email          String    @default("")
  userId         String?   @map("user_id") @db.Uuid
  dueDate        DateTime  @map("due_date") @db.Date
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedBy     String?   @map("approved_by") @db.Uuid
  approveComment String    @default("") @map("approve_comment")
  addedBy        String    @map("added_by") @db.Uuid
  addedAt        DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)
  removedBy      String?   @map("removed_by") @db.Uuid

  document        Document                 @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version         DocumentVersion          @relation(fields: [versionId], references: [id], onDelete: Restrict)
  user            User?                    @relation("DocumentPartyUser", fields: [userId], references: [id], onDelete: Restrict)
  adder           User                     @relation("DocumentPartyAdder", fields: [addedBy], references: [id], onDelete: Restrict)
  approver        User?                    @relation("DocumentPartyApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  remover         User?                    @relation("DocumentPartyRemover", fields: [removedBy], references: [id], onDelete: Restrict)
  files           DocumentFile[]
  deadlineChanges DocumentDeadlineChange[]

  @@index([versionId])
  @@map("document_parties")
}

/// История сроков (ответственные лица этапа 14; переводы этапа 15 — релиз 1.2.0, этап Г4): было, стало, комментарий.
/// Только пополняется (права и триггер).
model DocumentDeadlineChange {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  partyId    String?  @map("party_id") @db.Uuid
  translationId String? @map("translation_id") @db.Uuid
  fromDate   DateTime @map("from_date") @db.Date
  toDate     DateTime @map("to_date") @db.Date
  comment    String
  actorId    String   @map("actor_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(3)

  document Document       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  party    DocumentParty? @relation(fields: [partyId], references: [id], onDelete: Restrict)
  translation DocumentTranslation? @relation(fields: [translationId], references: [id], onDelete: Restrict)
  actor    User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([documentId, at])
  @@map("document_deadline_changes")
}

/// Переводы этапа 15 (релиз 1.2.0, этап Г4): язык, переводчик — пользователь портала, срок; перевод готов, когда
/// приложен файл (document_files, вид translation). 15 → 16 — когда у каждого языка есть файл.
model DocumentTranslation {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId   String    @map("document_id") @db.Uuid
  versionId    String    @map("version_id") @db.Uuid
  language     String
  /// С 1.4.0 (решение владельца 9) — тот, кто добавил строку: переводчик больше не пользователь портала. Колонка
  /// остаётся NOT NULL ради отката на 1.3.0; до 1.4.0 — переводчик-пользователь.
  translatorId String    @map("translator_id") @db.Uuid
  /// Имя переводчика текстом (1.4.0), необязательное; для строк до 1.4.0 заполнено миграцией из ФИО учётной записи.
  translatorName String  @default("") @map("translator_name")
  dueDate      DateTime  @map("due_date") @db.Date
  addedBy      String    @map("added_by") @db.Uuid
  addedAt      DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)
  removedBy    String?   @map("removed_by") @db.Uuid

  document        Document                 @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version         DocumentVersion          @relation(fields: [versionId], references: [id], onDelete: Restrict)
  translator      User                     @relation("DocumentTranslator", fields: [translatorId], references: [id], onDelete: Restrict)
  adder           User                     @relation("DocumentTranslationAdder", fields: [addedBy], references: [id], onDelete: Restrict)
  remover         User?                    @relation("DocumentTranslationRemover", fields: [removedBy], references: [id], onDelete: Restrict)
  files           DocumentFile[]
  deadlineChanges DocumentDeadlineChange[]

  @@index([versionId])
  @@index([translatorId])
  @@map("document_translations")
}

/// Блокеры документа (релиз 1.2.0): что мешает двигать документ дальше. Открывают и снимают автор, старшие над автором
/// и начальник ИБ; снятие — с комментарием. Не удаляются; снятие — один раз.
model DocumentBlocker {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  versionId      String    @map("version_id") @db.Uuid
  text           String
  openedBy       String    @map("opened_by") @db.Uuid
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolveComment String    @default("") @map("resolve_comment")

  document Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version  DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  opener   User            @relation("DocumentBlockerOpener", fields: [openedBy], references: [id], onDelete: Restrict)
  resolver User?           @relation("DocumentBlockerResolver", fields: [resolvedBy], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@map("document_blockers")
}

/// Файлы (этап 7, CLAUDE.md 3.7): содержимое — /data/files/<yyyy>/<mm>/<uuid>, здесь — метаданные.
/// Физически не удаляется; deleted_at — только когда на файл нет ссылок (права и триггер).
model File {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Путь внутри FILES_DIR: «2026/10/<uuid>», исходное имя в пути не используется.
  storageKey   String    @unique @map("storage_key")
  originalName String    @map("original_name")
  /// Тип по содержимому (сигнатуре), а не по присланному браузером.
  mime         String
  size         BigInt
  sha256       String    @db.Char(64)
  uploadedBy   String    @map("uploaded_by") @db.Uuid
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy    String?   @map("deleted_by") @db.Uuid

  uploader      User                 @relation("FileUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  deleter       User?                @relation("FileDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)
  decisions     RegisterDecision[]
  versions      DocumentVersion[]
  documentLinks DocumentFile[]
  approvalNotes DocumentApproval[]
  evidenceLinks EvidenceFile[]
  recordLinks   RegisterRecordFile[]
  imports       RegisterImport[]
  text          FileText?

  @@index([uploadedBy, uploadedAt])
  @@map("files")
}

/// Доказательство (этап 7): привязано ровно к одному объекту — записи реестра, документу или системе.
model Evidence {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number        Int       @unique @default(autoincrement())
  /// form — форма подтверждения по шаблону; decision — решение другого отдела; file — протокол, скриншот…
  kind          String
  title         String
  recordId      String?   @map("record_id") @db.Uuid
  documentId    String?   @map("document_id") @db.Uuid
  /// Значение справочника «Системы».
  systemItemId  String?   @map("system_item_id") @db.Uuid
  templateId    String?   @map("template_id") @db.Uuid
  /// Снимок полей шаблона и значений формы: правка шаблона старые формы не меняет (триггер).
  checks        Json?
  decisionId    String?   @unique @map("decision_id") @db.Uuid
  /// Кто подтвердил со стороны ДИКТ (ФИО и должность).
  confirmedBy   String    @default("") @map("confirmed_by")
  /// Ответственный за продление: ему задача за 30 дней до окончания срока действия.
  ownerId       String    @map("owner_id") @db.Uuid
  /// pending | accepted | rejected
  status        String    @default("pending")
  /// NULL — бессрочно.
  validUntil    DateTime? @map("valid_until") @db.Date
  reviewedBy    String?   @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewComment String    @default("") @map("review_comment")
  uploadedBy    String    @map("uploaded_by") @db.Uuid
  version       Int       @default(1)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  record   RegisterRecord?   @relation(fields: [recordId], references: [id], onDelete: Restrict)
  document Document?         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  system   CatalogItem?      @relation(fields: [systemItemId], references: [id], onDelete: Restrict)
  template FormTemplate?     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  decision RegisterDecision? @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  owner    User              @relation("EvidenceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  uploader User              @relation("EvidenceUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  reviewer User?             @relation("EvidenceReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  files    EvidenceFile[]
  events   AutomationEvent[]
  tasks    Task[]

  @@index([recordId])
  @@index([documentId])
  @@index([systemItemId, templateId])
  @@index([status, validUntil])
  @@map("evidence")
}

/// Файлы доказательства. Отвязка — removed_at (строки не удаляются: права).
model EvidenceFile {
  evidenceId String    @map("evidence_id") @db.Uuid
  fileId     String    @map("file_id") @db.Uuid
  addedBy    String    @map("added_by") @db.Uuid
  addedAt    DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(3)
  removedBy  String?   @map("removed_by") @db.Uuid

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  file     File     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  adder    User     @relation("EvidenceFileAdder", fields: [addedBy], references: [id], onDelete: Restrict)
  remover  User?    @relation("EvidenceFileRemover", fields: [removedBy], references: [id], onDelete: Restrict)

  @@id([evidenceId, fileId])
  @@index([fileId])
  @@map("evidence_files")
}

// ---------------------------------------------------------------------------
// Дашборд (этап 8)
// ---------------------------------------------------------------------------

/// Плитка-счётчик: записи реестра, где поле ∈ {значения}, без закрытых. Удаление мягкое (без DELETE у роли приложения).
model DashboardTile {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registerId String    @map("register_id") @db.Uuid
  fieldId    String    @map("field_id") @db.Uuid
  title      String
  /// id значений списка или справочника.
  optionIds  String[]  @map("option_ids") @db.Uuid
  sortOrder  Int       @default(0) @map("sort_order")
  version    Int       @default(1)
  /// NULL — стартовая плитка seed (этап 8б): при первой установке пользователей ещё нет.
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  register Register      @relation(fields: [registerId], references: [id], onDelete: Restrict)
  field    RegisterField @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  author   User?         @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("dashboard_tiles")
}

/// Файлы поля «Файл» записи реестра (этап 8б, ADR-0013). Отвязка мягкая (removed_at); строки не удаляются.
/// Пока статус записи фиксирует поле, ссылку нельзя снять и нельзя добавить вторую (триггер в БД).
model RegisterRecordFile {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordId  String    @map("record_id") @db.Uuid
  fieldId   String    @map("field_id") @db.Uuid
  fileId    String    @map("file_id") @db.Uuid
  addedBy   String    @map("added_by") @db.Uuid
  addedAt   DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(3)
  removedBy String?   @map("removed_by") @db.Uuid

  record  RegisterRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  field   RegisterField  @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  file    File           @relation(fields: [fileId], references: [id], onDelete: Restrict)
  adder   User           @relation("RecordFileAdder", fields: [addedBy], references: [id], onDelete: Restrict)
  remover User?          @relation("RecordFileRemover", fields: [removedBy], references: [id], onDelete: Restrict)

  @@index([recordId, fieldId])
  @@index([fileId])
  @@map("register_record_files")
}

/// Текст PDF для полнотекстового поиска (этап 8б). Извлекает фоновый прогон (lib/pdf-text.ts).
/// status: pending — ждёт разбора; text — текст есть; no_text — текстового слоя нет (скан); failed — файл не разобран.
model FileText {
  fileId      String                   @id @map("file_id") @db.Uuid
  status      String                   @default("pending")
  content     String?
  pages       Int?
  /// Причина failed — для журнала, без содержимого файла.
  error       String?
  attempts    Int                      @default(0)
  extractedAt DateTime?                @map("extracted_at") @db.Timestamptz(3)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  /// to_tsvector('russian', content) — вычисляемая колонка, пишет только БД.
  tsv         Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(content, ''::text))"))

  file File @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([tsv], type: Gin)
  @@map("file_texts")
}

/// Уведомления в портале (релиз 1.2.0, ADR-0023). Видит только адресат. Служебные строки: прочитанные старше 90 дней
/// и непрочитанные старше 180 дней удаляет фоновая очистка (одной записью в журнале аудита).
model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Вид события: task_assigned, task_unassigned, task_submitted, task_returned, task_accepted, task_completed, task_moved,
  /// task_commented, task_due_tomorrow, task_overdue; виды документов — этап Г. Проверяется в коде.
  kind       String
  /// Снимок текста на момент события.
  title      String
  body       String    @default("")
  taskId     String?   @map("task_id") @db.Uuid
  documentId String?   @map("document_id") @db.Uuid
  /// Кто сделал; NULL — система.
  actorId    String?   @map("actor_id") @db.Uuid
  /// «Срок завтра» и «просрочено»: одно уведомление адресату на задачу и срок.
  dedupeKey  String?   @map("dedupe_key")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)

  user     User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  actor    User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("notifications")
}

/// Методика самооценки (этап Д, ADR-0025): домены, разделы, критерии, шкала, уровни, правила. Одна активная на код.
model AssessmentMethodology {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String
  name       String
  version    Int
  content    Json
  isActive   Boolean   @default(false) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  assessments Assessment[]

  @@unique([code, version])
  @@map("assessment_methodologies")
}

/// Оценка (этап Д): снимок методики, профиль, статус draft → final → archived. Итог черновика считается при чтении
/// (lib/assessment-score.ts), при фиксации замораживается в result. Удаления нет — только архив (ADR-0026).
model Assessment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  methodologyId       String    @map("methodology_id") @db.Uuid
  methodologySnapshot Json      @map("methodology_snapshot")
  title               String
  assessedOn          DateTime  @map("assessed_on") @db.Date
  /// draft | final | archived
  status              String    @default("draft")
  profile             Json      @default("{}")
  previousId          String?   @map("previous_id") @db.Uuid
  result              Json?
  finalizedBy         String?   @map("finalized_by") @db.Uuid
  finalizedAt         DateTime? @map("finalized_at") @db.Timestamptz(3)
  reopenComment       String    @default("") @map("reopen_comment")
  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version             Int       @default(1)
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)

  methodology AssessmentMethodology @relation(fields: [methodologyId], references: [id], onDelete: Restrict)
  previous    Assessment?           @relation("AssessmentPrevious", fields: [previousId], references: [id], onDelete: Restrict)
  next        Assessment[]          @relation("AssessmentPrevious")
  creator     User                  @relation("AssessmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  finalizer   User?                 @relation("AssessmentFinalizer", fields: [finalizedBy], references: [id], onDelete: Restrict)
  answers     AssessmentAnswer[]

  @@map("assessments")
}

/// Ответ раздела: 24 строки на оценку, создаются сразу; «не отвечено» — level IS NULL. Меняется только в черновике (триггер).
model AssessmentAnswer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  sectionCode  String   @map("section_code")
  level        Int?     @db.SmallInt
  targetLevel  Int?     @map("target_level") @db.SmallInt
  comment      String   @default("")
  updatedBy    String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  version      Int      @default(1)

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  updater    User?            @relation(fields: [updatedBy], references: [id], onDelete: Restrict)
  links      AssessmentLink[]

  @@unique([assessmentId, sectionCode])
  @@map("assessment_answers")
}

/// Связь раздела с сущностью портала (задача; доказательство и документ — этап 2). Видна только внутри раздела.
model AssessmentLink {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answerId   String   @map("answer_id") @db.Uuid
  /// task | evidence | document
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  answer  AssessmentAnswer @relation(fields: [answerId], references: [id], onDelete: Restrict)
  creator User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([answerId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("assessment_links")
}
