// Схема меняется только миграциями (CLAUDE.md, раздел 3.3):
//   npx prisma migrate dev --create-only --name <что_меняем>
// Применённые файлы в migrations/ не правятся.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  login              String    @unique
  fullName           String    @map("full_name")
  position           String    @default("")
  department         String    @default("")
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  /// От этой даты считается срок действия пароля (90 дней).
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  isActive           Boolean   @default(true) @map("is_active")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordHistory PasswordHistory[]
  mailRules       CatalogItem[]
  roles           UserRole[]        @relation("UserRoles")
  assignedRoles   UserRole[]        @relation("UserRolesAssignedBy")
  sessions        Session[]
  auditEntries    AuditLog[]

  @@map("users")
}

model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model Permission {
  code        String @id
  name        String
  description String @default("")
  sortOrder   Int    @default(0) @map("sort_order")

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String?  @unique
  name        String   @unique
  description String   @default("")
  isSystem    Boolean  @default(false) @map("is_system")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user     User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner User? @relation("UserRolesAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// id — sha256 от токена из cookie; сам токен в БД не хранится.
model Session {
  id         String    @id
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// Только пополняется (CLAUDE.md, раздел 3.5). UPDATE и DELETE запрещены правами и триггером.
model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now()) @db.Timestamptz(3)
  userId   String?  @map("user_id") @db.Uuid
  action   String
  entity   String?
  entityId String?  @map("entity_id")
  diff     Json?
  ip       String?

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([at])
  @@index([entity, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Настройки (этап 2). Частичные уникальные индексы и CHECK — в SQL миграции.
// ---------------------------------------------------------------------------

/// Набор справочников фиксирован, создаётся seed.
model Catalog {
  code        String  @id
  name        String
  description String  @default("")
  /// values | statuses | mail_rules
  kind        String
  hasColor    Boolean @default(false) @map("has_color")
  sortOrder   Int     @default(0) @map("sort_order")

  items CatalogItem[]

  @@map("catalogs")
}

model CatalogItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogCode String    @map("catalog_code")
  value       String
  /// Ключ тона из tokens.css: accent, info, low, high, med, crit, muted
  color       String?
  /// Есть только у системных значений, на них опирается логика.
  systemKey   String?   @map("system_key")
  isSystem    Boolean   @default(false) @map("is_system")
  /// Только для правил разбора почты.
  keywords    String[]  @default([])
  ownerUserId String?   @map("owner_user_id") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  version     Int       @default(1)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  catalog Catalog @relation(fields: [catalogCode], references: [code], onDelete: Restrict)
  owner   User?   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@unique([catalogCode, systemKey])
  @@index([catalogCode, sortOrder])
  @@map("catalog_items")
}

/// Производственный календарь РТ: отклонения от обычной недели.
model WorkCalendarDay {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day       DateTime  @db.Date
  /// holiday — нерабочий день; workday — рабочий день (перенос на выходной)
  kind      String
  title     String
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([day])
  @@map("work_calendar_days")
}

/// Настройки портала: ключ → значение (например, выходные дни недели).
model AppSetting {
  key       String   @id
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

/// Отметки однократного seed: стартовые значения создаются только при первой установке.
model SeedMarker {
  key       String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(3)

  @@map("seed_markers")
}

model FormTemplate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  /// Документ-основание текстом; ссылка на documents появится на этапе 6.
  basis       String    @default("")
  validMonths Int       @map("valid_months")
  version     Int       @default(1)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  fields FormTemplateField[]

  @@map("form_templates")
}

model FormTemplateField {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String    @map("template_id") @db.Uuid
  label      String
  /// min | max | yes | text
  checkKind  String    @map("check_kind")
  threshold  Decimal?  @db.Decimal(14, 2)
  sortOrder  Int       @default(0) @map("sort_order")
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  template FormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([templateId, sortOrder])
  @@map("form_template_fields")
}
