# Скопируйте в .env и заполните: cp .env.example .env && chmod 600 .env
# .env в git не попадает. Пароли — длинные случайные строки, например: openssl rand -hex 24

# Версия релиза (совпадает с файлом VERSION и тегом образов)
VERSION=0.1.0

# Владелец схемы: только для миграций (сервис migrate)
DB_OWNER_USER=ibportal_owner
DB_OWNER_PASSWORD=change-me

# Роль работающего backend (права только на данные)
DB_APP_USER=ibportal_app_login
DB_APP_PASSWORD=change-me

# Адрес портала — как его открывают пользователи в браузере: https://, имя сервера и порт, если не 443.
# Без пути. С ним backend сверяет Origin изменяющих запросов (защита от подделки запросов с чужих страниц):
# портал, открытый по другому адресу (по IP, по другому имени), не даст сохранить изменения. Обязателен.
PORTAL_URL=

# Подпись cookie сессии, не короче 32 символов: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-hex-characters

# Часовой пояс, в котором считается «сегодня» для сроков и автоматизаций (IANA)
APP_TZ=Asia/Dushanbe

# Как часто backend проверяет правила автоматизаций, минут (1–1440; 0 — не проверять по расписанию)
AUTOMATION_INTERVAL_MIN=60

# Настенный монитор (этап 8): IP-адреса или подсети компьютеров у мониторов, через запятую,
# например 10.0.5.21, 10.0.6.0/28. Пусто — учётная запись «Настенный монитор» войти не может.
MONITOR_ALLOWED_IPS=

# Рабочие места администраторов (ADR-0015): IP-адреса или подсети через запятую. Пользователь с правами
# «Настройки» (settings.manage) или «Пользователи, роли и права» (users.manage) входит только с них;
# с другого адреса — «Неверный логин или пароль», причина в журнале аудита (admin_ip_denied).
# Пусто — без ограничения. Ошибся в списке и никто не может войти — исправить здесь и docker compose up -d backend.
ADMIN_ALLOWED_IPS=

# Сервер OnlyOffice банка (ADR-0010): ссылка на файл документа принимается, только если начинается с этого адреса
# (тот же протокол, сервер и порт, путь с указанного). Пример: https://onlyoffice.bank.local/
# Без логина, параметров (?) и якоря (#). Пусто — любая ссылка http(s). Уже сохранённые ссылки не проверяются.
ONLYOFFICE_URL_PREFIX=

# Сеть между nginx и backend (этап 8). У nginx постоянный адрес, backend верит X-Forwarded-For только ему.
# Менять, только если подсеть пересекается с сетями банка: все три значения вместе.
FRONT_SUBNET=172.31.250.0/29
# Сеть backend ↔ db (internal). Тоже согласуется с сетевым отделом до первой выкладки.
BACK_SUBNET=172.31.249.0/24
FRONTEND_IP=172.31.250.6
# Кому backend верит в X-Forwarded-For (IP и подсети через запятую). За обратным прокси или балансировщиком (если появятся) добавьте
# их адреса и верните в frontend/nginx.conf передачу цепочки ($proxy_add_x_forwarded_for) — см. ADR-0012.
TRUSTED_PROXY_IPS=172.31.250.6
