# Dev-окружение: cp .env.dev.example .env.dev
# Значения ниже — заглушки только для локальной разработки.
DB_OWNER_USER=ibportal_owner
DB_OWNER_PASSWORD=dev-owner-password
DB_APP_USER=ibportal_app_login
DB_APP_PASSWORD=dev-app-password
SESSION_SECRET=dev-session-secret-dev-session-secret-0000

# Часовой пояс, в котором считается «сегодня» для сроков и автоматизаций (IANA)
APP_TZ=Asia/Dushanbe

# Как часто backend проверяет правила автоматизаций, минут (1–1440; 0 — не проверять по расписанию)
AUTOMATION_INTERVAL_MIN=60

# Настенный монитор: с каких адресов разрешён вход. В dev браузер виден с адреса шлюза сети front.
# Пусто — вход учётной записи «Настенный монитор» запрещён.
MONITOR_ALLOWED_IPS=

# Рабочие места администраторов (ADR-0015). Пусто — без ограничения. Проверка в dev: 172.31.251.1.
ADMIN_ALLOWED_IPS=

# Сервер OnlyOffice (ADR-0010). Пусто — любая ссылка http(s).
ONLYOFFICE_URL_PREFIX=

# Адрес dev в браузере (Vite): с ним backend сверяет Origin изменяющих запросов. По умолчанию http://localhost:5173.
PORTAL_URL=http://localhost:5173

# Сеть backend ↔ db в dev (не пересекается с серверными подсетями и с dev-сетью front 172.31.251.0/29)
BACK_SUBNET=172.31.252.0/24
