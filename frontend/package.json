{
  "name": "ibportal-frontend",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node --env-file-if-exists=.env.e2e --test --test-concurrency=1 \"e2e/**/*.e2e.mjs\"",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.6",
    "@tanstack/react-query": "5.87.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "pdfjs-dist": "6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
