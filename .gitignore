# секреты
.env
.env.*
*.env
!.env.example
!.env.dev.example
deploy/certs/

# сборка, зависимости и релизы (dist/ibportal-<VERSION>/ из make-release.sh)
node_modules/
dist/
coverage/
# клиент Prisma 7 — генерируется из schema.prisma (prisma generate), ADR-0014
backend/src/generated/
*.tsbuildinfo

# служебное
# локальные настройки и скиллы Claude Code (решение владельца 04.11.2026: в репозиторий не входят)
.claude/
# снимки экранов к аудитам интерфейса — вне репозитория (решение владельца 04.11.2026), в git только README и текстовые отчёты
docs/audit/**/*.jpg
docs/audit/**/*.png
.DS_Store
*.log
deploy/scripts/.smoke/
# учётная запись e2e (только dev), см. frontend/e2e
frontend/.env.e2e

# Рабочие материалы эксплуатации (ответы DevOps с внутренними адресами) — в git не попадают, репозиторий публичный
ops/
